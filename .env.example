# Kopieren nach .env und anpassen. Die Datei .env wird nicht ins Repository übernommen.

# Ports auf dem Homeserver (8080 ist dort schon durch zigbee2mqtt belegt)
# Freie Ports prüfen:  ss -tlnp | grep -E ':(8090|8091) '   (keine Ausgabe = frei)
IPAD_PORT=8090
PC_PORT=8091

# Öffentliche Adresse der iPad-Ansicht (für den iCal-Link von Fewo 1), z. B. über Cloudflare Tunnel
# PUBLIC_URL=https://kalender.example.de

# Zugangsschlüssel für die iPad-Ansicht. Wenn gesetzt, einmalig auf dem iPad öffnen:
#   https://kalender.example.de/?key=DEIN-SCHLÜSSEL
# danach bleibt das iPad ein Jahr angemeldet. Empfohlen, sobald die Ansicht aus dem Internet erreichbar ist.
# VIEW_KEY=

# Passwort für die PC-Verwaltung (Benutzername beliebig). Empfohlen.
# ADMIN_PASSWORD=

# Abruf der Schulferien/Feiertage (Standard Baden-Württemberg)
# HOLIDAY_REGION=DE-BW

# Smoobu-API (nur lesen). Schlüssel erzeugst du in Smoobu unter Einstellungen → Erweitert → API-Schlüssel.
# Nur hier auf dem Server eintragen, nirgends sonst weitergeben. Danach: docker compose up -d
# SMOOBU_API_KEY=
# SMOOBU_API_SECRET=
# Standard: HMAC, wenn ein Secret gesetzt ist. Nur für den alten Api-Key (gilt bis 31.10.2026): legacy
# SMOOBU_AUTH=hmac
